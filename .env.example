PORT=3000
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# 로그인 (Supabase > Project Settings > API) — 비워두면 로그인 메뉴가 숨겨짐
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 로그인 버튼 종류 (kakao,google,apple,email 중 선택)
AUTH_PROVIDERS=kakao,google,email
# true면 로그인 필수 + 계정당 하루 1회 (supabase/schema.sql 실행 필요)
DAILY_LIMIT_ENABLED=false

# 맥에서 돌리는 로컬 모델 (local-llm/agent.js, `npm run local-llm`)
# 맥의 .env에만 넣는다 — 만들기: openssl rand -hex 24
# 사이트에는 키 대신 SHA-256 값을 둔다(server.js 기본값 또는 LOCAL_LLM_SECRET_SHA256)
LOCAL_LLM_SECRET=
LOCAL_LLM_MODEL=gpt-oss:20b
# 맥의 agent.js가 터널 주소를 등록할 사이트 주소
SITE_URL=https://saju-tokki.onrender.com
